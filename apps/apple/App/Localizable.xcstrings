    "OPPO 兼容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO Compatible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO 兼容"
          }
        }
      }
    },
    "OPPO 兼容恢复 OPPO 兼容结构、元数据和尾部数据；Apple 标准保留 Apple 照片结果且不写入 OPPO 私有信息，可按开关恢复可见原机水印。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO Compatible restores the OPPO structure, metadata and private tail. Apple Standard keeps the Apple Photos result without OPPO private data; the visible camera watermark can be restored with the switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO 兼容恢复 OPPO 兼容结构、元数据和尾部数据；Apple 标准保留 Apple 照片结果且不写入 OPPO 私有信息，可按开关恢复可见原机水印。"
          }
        }
      }
    },
    "OPPO 兼容输出必须保留 OPPO 原始照片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO Compatible output needs the OPPO original to stay selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO 兼容输出必须保留 OPPO 原始照片。"
          }
        }
      }
    },
    "OPPO 原始照片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO original"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO 原始照片"
          }
        }
      }
    },
    "OPPO 原始照片 → Apple 编辑副本 → iPhone 编辑 → 写回原机水印与元数据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO original → Apple edit copy → edit on iPhone → write the watermark and metadata back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OPPO 原始照片 → Apple 编辑副本 → iPhone 编辑 → 写回原机水印与元数据"
          }
        }
      }
    },
