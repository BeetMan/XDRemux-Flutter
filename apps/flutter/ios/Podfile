# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Vendored Rust core + x265 static libraries (see xdremux_core.podspec).
  pod 'xdremux_core', :path => './xdremux_core.podspec'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Force iOS 15.0 minimum — Xcode 27 requires >= 15.0.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Force-link the Rust core + x265 archives into the Runner app target.
  # Dart resolves FFI symbols at runtime via DynamicLibrary.process(), so the
  # linker sees no compile-time reference and would skip plain -l archives.
  # The Runner build uses Pods-Runner.xcconfig's OTHER_LDFLAGS (it overrides the
  # pbxproj value), so we patch that file directly. Force-load from a space-free
  # dir (repo path has spaces). Staged by build_ios.sh.
  libdir = File.join(Dir.home, 'xdremux_ios_libs')
  force = "-force_load #{File.join(libdir, 'libx265.a')} -force_load #{File.join(libdir, 'libxdremux_core.a')} -lc++ -framework Security"
  Dir.glob(File.join(File.expand_path('Pods', __dir__), 'Target Support Files', 'Pods-Runner', '*.xcconfig')).each do |f|
    content = File.read(f)
    # Replace the whole OTHER_LDFLAGS line: keep inherited + plugin frameworks,
    # drop the auto -l"x265"/-l"xdremux_core" (they'd double-link), append the
    # force-load flags.
    content = content.sub(
      /^OTHER_LDFLAGS = .*$/,
      "OTHER_LDFLAGS = $(inherited) -ObjC -framework \"flutter_foreground_task\" -framework \"open_filex\" -framework \"Security\" #{force}"
    )
    File.write(f, content)
  end
end
