    "兼容 OPPO / 一加相册的标准文件格式，恢复原机结构与私有尾部数据，支持后续编辑。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard format for the OPPO and OnePlus gallery. Restores the original structure and private tail data; the photo stays editable there."
          }
        }
      }
    },
    "兼容策略": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibility"
          }
        }
      }
    },
    "内核报告成功但没有写出文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The core reported success but wrote no file"
